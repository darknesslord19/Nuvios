+package com.lagradost.cloudstream3.nuvio
+
+import com.lagradost.cloudstream3.SubtitleFile
+import com.lagradost.cloudstream3.TvType
+import com.lagradost.cloudstream3.metaproviders.TmdbLink
+import com.lagradost.cloudstream3.metaproviders.TmdbProvider
+import com.lagradost.cloudstream3.newSubtitleFile
+import com.lagradost.cloudstream3.utils.AppUtils.parseJson
+import com.lagradost.cloudstream3.utils.ExtractorLink
+import com.lagradost.cloudstream3.utils.ExtractorLinkType
+import com.lagradost.cloudstream3.utils.INFER_TYPE
+import com.lagradost.cloudstream3.utils.getQualityFromName
+import com.lagradost.cloudstream3.utils.newExtractorLink
+import java.util.Collections
+
+/**
+ * Catalog comes from TMDB; streams come from every installed Nuvio provider.
+ */
+class NuvioProvider : TmdbProvider() {
+    override var name = "Nuvio Eklentileri"
+    override var mainUrl = "https://www.themoviedb.org"
+    override var lang = "tr"
+    override val useMetaLoadResponse = true
+    override val instantLinkLoading = false
+    override val supportedTypes = setOf(TvType.Movie, TvType.TvSeries)
+
+    override suspend fun loadLinks(
+        data: String,
+        isCasting: Boolean,
+        subtitleCallback: (SubtitleFile) -> Unit,
+        callback: (ExtractorLink) -> Unit
+    ): Boolean {
+        val link = parseJson<TmdbLink>(data)
+        val tmdbId = link.tmdbID ?: return false
+        val isTv = link.season != null && link.episode != null
+        val mediaType = if (isTv) "tv" else "movie"
+
+        val found = Collections.synchronizedList(mutableListOf<Pair<NuvioScraper, LocalScraperResult>>())
+        NuvioPluginManager.getStreams(
+            tmdbId.toString(),
+            mediaType,
+            if (isTv) link.season else null,
+            if (isTv) link.episode else null,
+        ) { scraper, result -> found += scraper to result }
+
+        val seenSubs = HashSet<String>()
+        val results = synchronized(found) { found.toList() }
+        for ((scraper, stream) in results) {
+            val headers = stream.headers ?: emptyMap()
+            val isHls = stream.url.substringBefore('?').endsWith(".m3u8", ignoreCase = true) ||
+                stream.type.equals("hls", ignoreCase = true)
+            val label = listOfNotNull(
+                stream.title.takeIf { it.isNotBlank() && it != stream.name },
+                stream.size
+            ).joinToString(" · ")
+
+            callback(
+                newExtractorLink(
+                    source = scraper.name,
+                    name = if (label.isBlank()) scraper.name else "${scraper.name} – $label",
+                    url = stream.url,
+                    type = if (isHls) ExtractorLinkType.M3U8 else INFER_TYPE
+                ) {
+                    this.quality = getQualityFromName(stream.quality ?: stream.title)
+                    this.headers = headers
+                    this.referer = headers.entries.firstOrNull {
+                        it.key.equals("Referer", ignoreCase = true)
+                    }?.value ?: ""
+                }
+            )
+
+            for (sub in stream.subtitles) {
+                if (!seenSubs.add(sub.url)) continue
+                subtitleCallback(newSubtitleFile(sub.lang, sub.url) {
+                    sub.headers?.let { this.headers = it }
+                })
+            }
+        }
+        return results.isNotEmpty()
+    }
+}
