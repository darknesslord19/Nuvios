diff --git a/app/src/main/java/com/lagradost/cloudstream3/ui/categories/CategoriesFragment.kt b/app/src/main/java/com/lagradost/cloudstream3/ui/categories/CategoriesFragment.kt
new file mode 100644
index 0000000..ec627f8
--- /dev/null
+++ b/app/src/main/java/com/lagradost/cloudstream3/ui/categories/CategoriesFragment.kt
@@ -0,0 +1,383 @@
+package com.lagradost.cloudstream3.ui.categories
+
+import android.annotation.SuppressLint
+import android.graphics.Color
+import android.os.Bundle
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.webkit.JavascriptInterface
+import android.webkit.WebChromeClient
+import android.webkit.WebResourceRequest
+import android.webkit.WebView
+import android.webkit.WebViewClient
+import android.widget.FrameLayout
+import androidx.activity.OnBackPressedCallback
+import androidx.fragment.app.Fragment
+import com.lagradost.cloudstream3.APIHolder
+import com.lagradost.cloudstream3.CloudStreamApp.Companion.getKey
+import com.lagradost.cloudstream3.CloudStreamApp.Companion.setKey
+import com.lagradost.cloudstream3.MainAPI
+import com.lagradost.cloudstream3.MainPageData
+import com.lagradost.cloudstream3.MainPageRequest
+import com.lagradost.cloudstream3.R
+import com.lagradost.cloudstream3.SearchResponse
+import com.lagradost.cloudstream3.TvType
+import com.lagradost.cloudstream3.mvvm.logError
+import com.lagradost.cloudstream3.ui.settings.Globals.EMULATOR
+import com.lagradost.cloudstream3.ui.settings.Globals.TV
+import com.lagradost.cloudstream3.ui.settings.Globals.isLayout
+import com.lagradost.cloudstream3.utils.AppContextUtils.loadSearchResult
+import com.lagradost.cloudstream3.utils.UIHelper.fixSystemBarsPadding
+import com.lagradost.cloudstream3.utils.UIHelper.navigate
+import com.lagradost.cloudstream3.utils.TmdbPosters
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withTimeoutOrNull
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.Locale
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * The home screen: the "Kategoriler" page (assets/home/index.html) in a WebView.
+ * Every category is filled from the main page sections of all installed providers.
+ *
+ * Page -> app (window.Cats): load, reload, open, cancel, close, animated, rich, isTv, getStore, setStore, remote
+ * App -> page: onCatStart(token, n), onCatResults(token, json), onCatDone(token, fromCache)
+ */
+class CategoriesFragment : Fragment() {
+    private var webView: WebView? = null
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var loadJob: Job? = null
+
+    /** Items shown on the page, by the id the page sends back in open(id). */
+    private val items = ConcurrentHashMap<String, SearchResponse>()
+
+    private val backCallback = object : OnBackPressedCallback(false) {
+        override fun handleOnBackPressed() {
+            val web = webView
+            if (web != null && web.canGoBack()) web.goBack() else {
+                isEnabled = false
+                activity?.onBackPressedDispatcher?.onBackPressed()
+            }
+        }
+    }
+
+    @SuppressLint("SetJavaScriptEnabled")
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?
+    ): View {
+        val root = FrameLayout(inflater.context)
+        root.setBackgroundColor(Color.parseColor("#0E0B0D"))
+        val web = WebView(inflater.context).apply {
+            setBackgroundColor(Color.parseColor("#0E0B0D"))
+            settings.javaScriptEnabled = true
+            settings.domStorageEnabled = true
+            settings.mediaPlaybackRequiresUserGesture = true
+            settings.allowFileAccess = true
+            isFocusable = true
+            isFocusableInTouchMode = true
+            webChromeClient = WebChromeClient()
+            webViewClient = object : WebViewClient() {
+                override fun shouldOverrideUrlLoading(view: WebView?, request: WebResourceRequest?): Boolean {
+                    // Stay on the page; nothing inside it navigates away.
+                    return request?.url?.scheme != "file"
+                }
+
+                override fun doUpdateVisitedHistory(view: WebView?, url: String?, isReload: Boolean) {
+                    super.doUpdateVisitedHistory(view, url, isReload)
+                    val canGoBack = view?.canGoBack() == true
+                    if (canGoBack && !backCallback.isEnabled) {
+                        // Put the page's back handling in front of the app's exit dialog
+                        backCallback.remove()
+                        val owner = viewLifecycleOwnerLiveData.value
+                        if (owner != null) activity?.onBackPressedDispatcher?.addCallback(owner, backCallback)
+                    }
+                    backCallback.isEnabled = canGoBack
+                }
+            }
+            addJavascriptInterface(CatsBridge(), "Cats")
+        }
+        root.addView(web, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+        webView = web
+        if (savedInstanceState != null) web.restoreState(savedInstanceState)
+        else web.loadUrl("file:///android_asset/home/index.html")
+        return root
+    }
+
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+        fixSystemBarsPadding(view, padBottom = false, padLeft = isLayout(TV or EMULATOR))
+        requireActivity().onBackPressedDispatcher.addCallback(viewLifecycleOwner, backCallback)
+        if (isLayout(TV)) webView?.requestFocus()
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        super.onSaveInstanceState(outState)
+        webView?.saveState(outState)
+    }
+
+    override fun onDestroyView() {
+        loadJob?.cancel()
+        webView?.apply {
+            removeJavascriptInterface("Cats")
+            stopLoading()
+            destroy()
+        }
+        webView = null
+        super.onDestroyView()
+    }
+
+    override fun onDestroy() {
+        scope.cancel()
+        super.onDestroy()
+    }
+
+    private fun js(script: String) {
+        val web = webView ?: return
+        web.post { webView?.evaluateJavascript(script, null) }
+    }
+
+    // ------------------------------------------------------------------ filling a category
+
+    private data class Spec(
+        val kind: String,
+        val keys: List<String>,
+        /** Only these providers; null means every provider. */
+        val sources: Set<String>? = null,
+        /** kind "section": the name of one main page section. */
+        val section: String? = null,
+    )
+
+    private fun norm(s: String) = s.lowercase(Locale.forLanguageTag("tr"))
+
+    private fun parseSpec(spec: String): Spec = try {
+        val o = JSONObject(spec)
+        val sources = o.optJSONArray("sources")?.let { arr ->
+            (0 until arr.length()).map { arr.optString(it) }.filter { it.isNotBlank() }.toSet()
+        }?.takeIf { it.isNotEmpty() }
+        Spec(
+            o.optString("kind", "genre"),
+            o.optString("keys", "").split(',').map { norm(it.trim()) }.filter { it.isNotEmpty() },
+            sources,
+            o.optString("section", "").takeIf { it.isNotBlank() },
+        )
+    } catch (e: Exception) {
+        Spec("genre", emptyList())
+    }
+
+    private val kindWords = mapOf(
+        "movie" to listOf("film", "movie", "sinema"),
+        "series" to listOf("dizi", "series", "show", "tv"),
+        "anime" to listOf("anim", "anime", "çizgi", "cartoon"),
+        "new" to listOf("yeni", "new", "son eklenen", "latest", "güncel", "recent", "vizyon"),
+    )
+
+    private val kindTypes = mapOf(
+        "movie" to setOf(TvType.Movie, TvType.AnimeMovie, TvType.Torrent),
+        "series" to setOf(TvType.TvSeries, TvType.AsianDrama, TvType.Cartoon, TvType.Documentary),
+        "anime" to setOf(TvType.Anime, TvType.OVA, TvType.AnimeMovie, TvType.Cartoon),
+    )
+
+    /** Sections of [api] that fit the category; second value tells whether items must be filtered by type. */
+    private fun sectionsFor(api: MainAPI, spec: Spec): Pair<List<MainPageData>, Boolean> {
+        val sections = api.mainPage.filter { it.data.isNotBlank() || it.name.isNotBlank() }
+        if (spec.kind == "section") return sections.filter { it.name == spec.section }.take(1) to false
+        if (spec.kind == "all") return emptyList<MainPageData>() to false
+        val words = spec.keys + (kindWords[spec.kind] ?: emptyList())
+        val matched = sections.filter { section ->
+            val n = norm(section.name)
+            words.any { n.contains(it) }
+        }
+        if (matched.isNotEmpty()) return matched.take(2) to false
+        return when (spec.kind) {
+            "movie", "series", "anime" -> {
+                if (kindTypes[spec.kind].orEmpty().none { it in api.supportedTypes }) emptyList<MainPageData>() to true
+                else sections.take(1) to true
+            }
+            "new" -> sections.take(1) to false
+            else -> emptyList<MainPageData>() to false
+        }
+    }
+
+    private fun startLoad(token: Int, specJson: String, page: Int) {
+        loadJob?.cancel()
+        val spec = parseSpec(specJson)
+        val providers = homeProviders().filter { spec.sources == null || it.name in spec.sources }
+        js("window.onCatStart && onCatStart($token, ${providers.size})")
+        if (providers.isEmpty()) return
+
+        loadJob = scope.launch {
+            val semaphore = Semaphore(4)
+            providers.map { api ->
+                async {
+                    semaphore.withPermit {
+                        val found = try {
+                            withTimeoutOrNull(25_000L) { loadFrom(api, spec, page) } ?: emptyList()
+                        } catch (e: Throwable) {
+                            logError(e)
+                            emptyList()
+                        }
+                        val json = JSONObject().apply {
+                            put("source", api.name)
+                            put("items", JSONArray().apply { found.forEach { put(it) } })
+                        }.toString()
+                        js("window.onCatResults && onCatResults($token, ${JSONObject.quote(json)})")
+                    }
+                }
+            }.awaitAll()
+            js("window.onCatDone && onCatDone($token, false)")
+        }
+    }
+
+    private fun homeProviders(): List<MainAPI> =
+        APIHolder.apis.filter { it.hasMainPage && it.name != "NONE" }.distinctBy { it.name }
+
+    /** Every provider for the repo pickers, with the sections that fit the category in [specJson]. */
+    private fun sourcesJson(specJson: String): String {
+        val spec = parseSpec(specJson)
+        val out = JSONArray()
+        for (api in homeProviders()) {
+            try {
+                val all = api.mainPage.map { it.name }.filter { it.isNotBlank() }
+                val match = sectionsFor(api, spec).first.map { it.name }.filter { it.isNotBlank() }
+                out.put(JSONObject().apply {
+                    put("name", api.name)
+                    put("lang", api.lang)
+                    put("nuvio", api is com.lagradost.cloudstream3.nuvio.NuvioProvider)
+                    put("sections", JSONArray(all))
+                    put("match", JSONArray(match))
+                })
+            } catch (e: Throwable) {
+                logError(e)
+            }
+        }
+        return out.toString()
+    }
+
+    private suspend fun loadFrom(api: MainAPI, spec: Spec, page: Int): List<JSONObject> {
+        val (sections, filterByType) = sectionsFor(api, spec)
+        if (sections.isEmpty()) return emptyList()
+        val wanted = kindTypes[spec.kind]
+        val out = LinkedHashMap<String, JSONObject>()
+        val noPoster = ArrayList<Pair<JSONObject, SearchResponse>>()
+        for (section in sections) {
+            val response = api.getMainPage(
+                page,
+                MainPageRequest(section.name, section.data, section.horizontalImages)
+            ) ?: continue
+            for (list in response.items) {
+                for (item in list.list) {
+                    if (filterByType && wanted != null && item.type != null && item.type !in wanted) continue
+                    val id = "${api.name}|${item.url}"
+                    if (out.containsKey(id)) continue
+                    items[id] = item
+                    val json = JSONObject().apply {
+                        put("id", id)
+                        put("name", item.name)
+                        item.posterUrl?.takeIf { it.isNotBlank() }?.let { put("poster", it) }
+                        item.quality?.let { put("quality", it.name) }
+                        dubOf(item)?.let { put("dub", it) }
+                    }
+                    out[id] = json
+                    if (item.posterUrl.isNullOrBlank()) noPoster += json to item
+                }
+            }
+        }
+        // Posters the provider did not give come from TMDB
+        if (noPoster.isNotEmpty()) coroutineScope {
+            val semaphore = Semaphore(6)
+            noPoster.map { (json, item) ->
+                async {
+                    semaphore.withPermit {
+                        val poster = withTimeoutOrNull(8_000L) { TmdbPosters.poster(item.name, item.type) }
+                        if (poster != null) {
+                            item.posterUrl = poster
+                            json.put("poster", poster)
+                        }
+                    }
+                }
+            }.awaitAll()
+        }
+        return out.values.toList()
+    }
+
+    private fun dubOf(item: SearchResponse): String? {
+        val n = norm(item.name)
+        return when {
+            n.contains("dublaj") -> "TR Dublaj"
+            n.contains("altyaz") -> "Altyazılı"
+            else -> null
+        }
+    }
+
+    // ------------------------------------------------------------------ bridge
+
+    private inner class CatsBridge {
+        @JavascriptInterface
+        fun load(token: Int, spec: String, page: Int) = startLoad(token, spec, page)
+
+        @JavascriptInterface
+        fun reload(token: Int, spec: String, page: Int) = startLoad(token, spec, page)
+
+        @JavascriptInterface
+        fun sources(spec: String): String = sourcesJson(spec)
+
+        @JavascriptInterface
+        fun cancel() {
+            loadJob?.cancel()
+        }
+
+        @JavascriptInterface
+        fun open(id: String) {
+            val item = items[id] ?: return
+            activity?.loadSearchResult(item)
+        }
+
+        /** The arrow in the page's header opens the classic, per-provider home. */
+        @JavascriptInterface
+        fun close() {
+            activity?.runOnUiThread {
+                try {
+                    activity?.navigate(R.id.navigation_classic_home)
+                } catch (e: Exception) {
+                    logError(e)
+                }
+            }
+        }
+
+        @JavascriptInterface
+        fun animated(): Boolean = true
+
+        @JavascriptInterface
+        fun rich(): Boolean = false
+
+        @JavascriptInterface
+        fun isTv(): Boolean = isLayout(TV)
+
+        @JavascriptInterface
+        fun getStore(key: String): String? = getKey<String>("$STORE_FOLDER/$key")
+
+        @JavascriptInterface
+        fun setStore(key: String, value: String) = setKey("$STORE_FOLDER/$key", value)
+
+        @JavascriptInterface
+        fun remote(): String = ""
+    }
+
+    companion object {
+        private const val STORE_FOLDER = "categories_page"
+    }
+}
