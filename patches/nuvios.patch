+++ b/app/src/main/assets/home/index.html
@@ -0,0 +1,1990 @@
+<!DOCTYPE html>
+<html lang="tr">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<title>Kategoriler</title>
+<!--
+  Kategoriler: hareketli kategori afişleri; içerikler eklenmiş bütün depolardan toplanır.
+  Uygulamaya: Cats.load(token, spec, page), Cats.open(id), Cats.cancel(), Cats.close(), Cats.animated(), Cats.isTv()
+  Uygulamadan: onCatStart(token, n), onCatResults(token, json), onCatDone(token)
+  Çizgi simgeler: Lucide (ISC lisansı) — https://lucide.dev
+-->
+<style>
+
+  :root {
+    --bg: #0E0B0D; --card: #1A1417; --field: #241B1F; --line: rgba(255, 240, 245, .09);
+    --ink: #FBF1F4; --muted: #A9939C; --accent: #F2A58E; --accent-ink: #2A1410;
+  }
+  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
+  html, body { margin: 0; background: var(--bg); color: var(--ink); }
+  body { font: 15px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; overflow-x: hidden; }
+  button { font: inherit; color: inherit; }
+  .app { max-width: 520px; margin: 0 auto; min-height: 100vh; position: relative; }
+  .screen { display: none; padding-bottom: 40px; }
+  .screen.on { display: block; animation: in .3s cubic-bezier(.2,.7,.2,1); }
+  @keyframes in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
+  .bar { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 8px; padding: 12px; background: linear-gradient(var(--bg) 70%, transparent); }
+  .bar h1 { flex: 1; margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -.3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+  .icon-btn { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 0; background: transparent; display: grid; place-items: center; color: var(--ink); }
+  .icon-btn:active { background: rgba(255,255,255,.08); }
+  .icon-btn svg { width: 24px; height: 24px; }
+  .hint { margin: 0 16px 14px; color: var(--muted); font-size: 13px; }
+  [hidden] { display: none !important; }
+
+  /* ---------- home mock ---------- */
+  .home { position: relative; height: 380px; overflow: hidden; border-radius: 0 0 22px 22px; }
+  .home .bgimg { position: absolute; inset: 0; background-size: cover; background-position: center; filter: brightness(.6); }
+  .home::after { content: ""; position: absolute; inset: 0; background: linear-gradient(rgba(0,0,0,.4), transparent 30%, transparent 50%, var(--bg)); }
+  .home .top { position: absolute; z-index: 2; top: 0; left: 0; right: 0; display: flex; align-items: center; gap: 4px; padding: 12px; }
+  .home .top .title { flex: 1; text-align: center; font-weight: 700; font-size: 18px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
+  .avatar { flex: none; width: 40px; height: 40px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #6fb2ff, #1b3fa0 70%); border: 2px solid rgba(255,255,255,.25); }
+  .cat-btn { background: rgba(0,0,0,.28); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,.18) !important; }
+  .cat-btn rect { transform-box: fill-box; transform-origin: center; }
+  .anim .cat-btn rect { animation: tile 3.2s ease-in-out infinite; }
+  .anim .cat-btn rect:nth-child(2) { animation-delay: .25s; }
+  .anim .cat-btn rect:nth-child(4) { animation-delay: .5s; }
+  .anim .cat-btn rect:nth-child(3) { animation-delay: .75s; }
+  @keyframes tile { 0%, 30%, 100% { transform: none; fill: transparent; } 12% { transform: scale(.78); fill: var(--accent); } }
+  .home .say { position: absolute; z-index: 2; left: 16px; right: 16px; bottom: 24px; text-align: center; }
+  .home .say b { display: block; font-size: 22px; }
+  .home .say span { color: var(--muted); font-size: 13px; }
+  .tip { position: absolute; z-index: 3; top: 62px; right: 50px; padding: 8px 12px; border-radius: 12px; background: var(--accent); color: var(--accent-ink); font-size: 13px; font-weight: 700; }
+  .tip::after { content: ""; position: absolute; top: -6px; right: 14px; border: 6px solid transparent; border-top: 0; border-bottom-color: var(--accent); }
+
+  /* ---------- cinematic covers (kept light: few layers, only what is on screen moves) ---------- */
+  .grid4 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 4px 16px 6px; }
+  .wide-list { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 0 16px; }
+  .cv {
+    position: relative; display: block; width: 100%; overflow: hidden; border: 0; padding: 0; cursor: pointer; text-align: left;
+    aspect-ratio: 3 / 4; border-radius: 20px; color: #fff; background: #15171a;
+    box-shadow: 0 12px 26px -14px rgba(0,0,0,.9); transform: translateZ(0); contain: layout paint;
+    transition: transform .25s cubic-bezier(.2,.7,.2,1);
+  }
+  .wide-list .cv { aspect-ratio: 16 / 10; border-radius: 16px; }
+  .cv:active { transform: scale(.97); }
+  .anim .cv.enter { animation: rise .6s cubic-bezier(.2,.7,.2,1) backwards; animation-delay: var(--d, 0s); }
+  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
+  /* the scene, slowly moving like a film camera while it is on screen */
+  .cv .scene { position: absolute; inset: 0; z-index: 0; }
+  .cv .scene i { position: absolute; inset: -7%; background-size: cover; background-position: center; opacity: 0; transition: opacity 1.2s ease; transform: scale(1.06); }
+  .cv .scene i.on { opacity: 1; }
+  .anim .cv.live .scene i.on { animation: kb var(--kb, 16s) ease-in-out infinite alternate; }
+  @keyframes kb { from { transform: scale(1.06) translate(var(--fx, -2%), var(--fy, 1%)); } to { transform: scale(1.18) translate(var(--tx2, 2%), var(--ty2, -2%)); } }
+  .cv.noir .scene i { filter: grayscale(1) contrast(1.1); }
+  /* the colour tone and the shade that keeps the name readable */
+  .cv .grade { position: absolute; inset: 0; z-index: 1; opacity: .42; }
+  .cv .shade { position: absolute; inset: 0; z-index: 2;
+    background: linear-gradient(180deg, rgba(0,0,0,.4) 0%, transparent 26%, transparent 38%, rgba(0,0,0,.92) 100%); }
+  /* a sheen that passes over the big cards now and then */
+  .cv::after { content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none; opacity: 0;
+    background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,.15) 50%, transparent 62%); transform: translateX(-100%); }
+  .anim .grid4 .cv.live::after { animation: sheen 7s ease-in-out infinite; animation-delay: calc(1.6s + var(--d, 0s) * 2.5); }
+  @keyframes sheen { 0% { transform: translateX(-100%); opacity: 0; } 4% { opacity: 1; } 16%, 100% { transform: translateX(100%); opacity: 0; } }
+  /* badge with a line icon */
+  .cv .badge { position: absolute; z-index: 4; top: 12px; left: 12px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
+    background: rgba(0,0,0,.38); border: 1px solid rgba(255,255,255,.28); }
+  .wide-list .cv .badge { width: 34px; height: 34px; top: 10px; left: 10px; }
+  .cv .badge svg { width: 20px; height: 20px; stroke: #fff; }
+  .wide-list .cv .badge svg { width: 17px; height: 17px; }
+  .anim .cv.enter .badge svg * { stroke-dasharray: 80; animation: trace 1.4s ease-out backwards; animation-delay: calc(.3s + var(--d, 0s)); }
+  @keyframes trace { from { stroke-dashoffset: 80; } to { stroke-dashoffset: 0; } }
+  .cv .txt { position: absolute; z-index: 5; left: 14px; right: 12px; bottom: 14px; }
+  .wide-list .cv .txt { left: 12px; bottom: 10px; }
+  .cv .txt small { display: block; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.78); }
+  .cv .txt b { display: block; margin-top: 2px; font-size: clamp(17px, 5.2vw, 26px); line-height: 1.04; font-weight: 900; letter-spacing: -.01em; text-transform: uppercase; text-shadow: 0 2px 10px rgba(0,0,0,.7); }
+  .wide-list .cv .txt b { font-size: 16px; letter-spacing: .02em; }
+  .cv .txt .rule { display: block; height: 3px; width: 46%; margin-top: 8px; border-radius: 3px; background: linear-gradient(90deg, var(--leak, #fff), transparent); transform-origin: left; }
+  .anim .cv.enter .txt .rule { animation: rule .9s cubic-bezier(.2,.7,.2,1) backwards; animation-delay: calc(.35s + var(--d, 0s)); }
+  @keyframes rule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
+  .wide-list .cv .txt .rule { display: none; }
+  /* one still grain over the whole page instead of one moving grain per card */
+  body::after { content: ""; position: fixed; inset: 0; z-index: 50; pointer-events: none; opacity: .05;
+    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
+
+  .section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 24px 16px 10px; }
+  .section-title h2 { margin: 0; font-size: 17px; font-weight: 800; }
+  .section-title small { color: var(--muted); }
+  .chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 16px; }
+  .chip { min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--field); color: var(--ink); font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; }
+  .chip.on { background: var(--accent); color: var(--accent-ink); border-color: transparent; }
+
+  /* ---------- results ---------- */
+  .sources { display: flex; gap: 8px; overflow-x: auto; padding: 0 16px 10px; scrollbar-width: none; }
+  .sources::-webkit-scrollbar { display: none; }
+  .sources .chip { flex: none; }
+  .posters { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding: 4px 16px; }
+  .poster { position: relative; aspect-ratio: 2 / 3; border-radius: 12px; overflow: hidden; background: var(--card); animation: rise .45s cubic-bezier(.2,.7,.2,1); }
+  .poster .p-art { position: absolute; inset: 0; background-size: cover; background-position: center; }
+  .poster::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 55%, rgba(0,0,0,.85)); }
+  .poster .p-name { position: absolute; z-index: 1; left: 6px; right: 6px; bottom: 6px; font-size: 12px; font-weight: 700; }
+  .poster .p-src { position: absolute; z-index: 1; top: 6px; left: 6px; max-width: calc(100% - 12px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 2px 7px; border-radius: 999px; background: rgba(0,0,0,.6); font-size: 10px; }
+  .loading { display: flex; align-items: center; gap: 10px; margin: 6px 16px 12px; color: var(--muted); font-size: 13px; }
+  .bar-p { flex: 1; height: 4px; border-radius: 999px; background: rgba(255,255,255,.1); overflow: hidden; }
+  .bar-p i { display: block; height: 100%; width: 0; background: var(--accent); transition: width .3s ease; }
+
+  /* ---------- editor ---------- */
+  .card { margin: 0 16px 12px; border-radius: 22px; background: var(--card); overflow: hidden; }
+  .row { display: flex; align-items: center; gap: 14px; min-height: 70px; padding: 10px 14px; border-top: 1px solid rgba(0,0,0,.35); }
+  .row:first-child { border-top: 0; }
+  .row .t { flex: 1; min-width: 0; cursor: pointer; }
+  .row .t b { display: block; }
+  .row .t span { color: var(--muted); font-size: 13px; }
+  .row .mini { flex: none; width: 46px; cursor: pointer; }
+  .row .mini .cv { border-radius: 10px; box-shadow: none; }
+  .row .mini .cv .txt, .row .mini .cv .badge { display: none; }
+  .switch { flex: none; width: 50px; height: 30px; border-radius: 999px; border: 0; background: rgba(255,255,255,.18); position: relative; }
+  .switch::after { content: ""; position: absolute; top: 4px; left: 4px; width: 22px; height: 22px; border-radius: 50%; background: #fff; transition: transform .2s; }
+  .switch[aria-checked="true"] { background: var(--accent); }
+  .switch[aria-checked="true"]::after { transform: translateX(20px); }
+  .pin { flex: none; min-height: 34px; padding: 0 10px; border-radius: 999px; border: 1px solid var(--line); background: var(--field); font-size: 12px; font-weight: 700; color: var(--muted); }
+  .pin.on { background: var(--accent); color: var(--accent-ink); border-color: transparent; }
+  .add { display: flex; align-items: center; justify-content: center; gap: 8px; width: calc(100% - 32px); margin: 4px 16px 16px; min-height: 52px; border-radius: 16px; border: 1.5px dashed var(--accent); background: transparent; color: var(--accent); font-weight: 700; }
+
+  .sheet-back { position: fixed; inset: 0; z-index: 20; background: rgba(0,0,0,.6); display: none; }
+  .sheet-back.on { display: block; }
+  .sheet { position: fixed; z-index: 21; left: 0; right: 0; bottom: 0; max-width: 520px; margin: 0 auto; max-height: 92vh; overflow-y: auto;
+    background: var(--bg); border-radius: 24px 24px 0 0; padding: 8px 16px 24px; transform: translateY(105%); visibility: hidden;
+    transition: transform .3s cubic-bezier(.2,.7,.2,1), visibility 0s .3s; }
+  .sheet.on { transform: none; visibility: visible; transition: transform .3s cubic-bezier(.2,.7,.2,1); }
+  .grab { width: 40px; height: 4px; border-radius: 999px; background: rgba(255,255,255,.2); margin: 6px auto 12px; }
+  .sheet h3 { margin: 0 0 12px; font-size: 18px; }
+  .field { display: block; margin-bottom: 16px; }
+  .field > span { display: block; margin-bottom: 8px; color: var(--muted); font-size: 13px; }
+  .field input { width: 100%; min-height: 48px; padding: 0 14px; border-radius: 14px; border: 1px solid var(--line); background: var(--field); color: var(--ink); font: inherit; }
+  .field input:focus { outline: 2px solid var(--accent); outline-offset: 0; }
+  .scenes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
+  .scenes button { position: relative; aspect-ratio: 16 / 10; border-radius: 10px; border: 2px solid transparent; background-origin: border-box; padding: 0; overflow: hidden; background-size: cover; background-position: center; }
+  .scenes button.on { border-color: var(--accent); box-shadow: 0 0 0 2px var(--bg) inset; }
+  .scenes button small { position: absolute; left: 0; right: 0; bottom: 0; padding: 8px 4px 3px; font-size: 9px; font-weight: 700; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.75)); text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+  .scenes .auto { display: grid; place-items: center; background: var(--field); color: var(--ink); font-size: 11px; font-weight: 700; padding: 4px; text-align: center; }
+  .grades { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
+  .grades button { position: relative; display: block; width: 100%; aspect-ratio: 1; border-radius: 50%; border: 2px solid transparent; padding: 0; }
+  .grades button.on { border-color: #fff; box-shadow: 0 0 0 3px var(--accent); }
+  .grades small { display: block; text-align: center; font-size: 10px; color: var(--muted); margin-top: 4px; }
+  .grades div { text-align: center; }
+  .icons { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; }
+  .icons button { aspect-ratio: 1; border-radius: 12px; border: 1px solid var(--line); background: var(--field); padding: 9px; display: grid; place-items: center; }
+  .icons button svg { width: 100%; height: 100%; stroke: var(--ink); }
+  .icons button.on { background: var(--accent); border-color: transparent; }
+  .icons button.on svg { stroke: var(--accent-ink); }
+  .preview { display: flex; justify-content: center; margin: 4px 0 16px; }
+  .preview > div { width: 52%; }
+  .actions { display: flex; gap: 10px; }
+  .btn { flex: 1; min-height: 50px; border-radius: 14px; border: 0; font-weight: 800; }
+  .btn.main { background: var(--accent); color: var(--accent-ink); }
+  .btn.ghost { background: var(--field); color: var(--ink); }
+  .btn.danger { background: rgba(248,113,113,.14); color: #f87171; }
+  .err { color: #f87171; font-size: 13px; margin: -8px 0 12px; }
+  .toast { position: fixed; left: 50%; bottom: 26px; z-index: 30; transform: translate(-50%, 20px); opacity: 0; padding: 10px 16px; border-radius: 999px; background: var(--ink); color: var(--bg); font-size: 14px; transition: .2s; pointer-events: none; }
+  .toast.on { opacity: 1; transform: translate(-50%, 0); }
+
+  .more { display: flex; align-items: center; justify-content: center; gap: 8px; width: calc(100% - 32px); margin: 16px; min-height: 50px; border-radius: 16px; border: 1px solid var(--line); background: var(--field); color: var(--ink); font-weight: 700; }
+  .empty { margin: 30px 24px; text-align: center; color: var(--muted); }
