@@ -0,0 +1,234 @@
+package com.lagradost.cloudstream3.nuvio
+
+import android.util.Log
+import com.lagradost.cloudstream3.APIHolder
+import com.lagradost.cloudstream3.CloudStreamApp.Companion.context
+import com.lagradost.cloudstream3.CloudStreamApp.Companion.getKey
+import com.lagradost.cloudstream3.CloudStreamApp.Companion.setKey
+import com.lagradost.cloudstream3.app
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/**
+ * Keeps track of Nuvio provider repositories, downloads their JS providers
+ * and runs them through [NuvioRuntime].
+ */
+object NuvioPluginManager {
+    private const val TAG = "NuvioPlugins"
+    private const val REPOS_KEY = "NUVIO_REPOSITORIES"
+    private const val SCRAPERS_KEY = "NUVIO_SCRAPERS"
+    private const val FOLDER = "nuvio_providers"
+    private const val MAX_PARALLEL = 3
+
+    private val runtime by lazy { NuvioRuntime() }
+    private val lock = Mutex()
+
+    fun getRepositories(): List<NuvioRepo> =
+        getKey<Array<NuvioRepo>>(REPOS_KEY)?.toList() ?: emptyList()
+
+    fun getScrapers(): List<NuvioScraper> =
+        getKey<Array<NuvioScraper>>(SCRAPERS_KEY)?.toList() ?: emptyList()
+
+    fun hasRepositories(): Boolean = getRepositories().isNotEmpty()
+
+    fun isNuvioRepository(url: String): Boolean = getRepositories().any { it.url == url }
+
+    private fun folderFor(repoUrl: String): File? {
+        val ctx = context ?: return null
+        return File(ctx.filesDir, "$FOLDER/${Integer.toHexString(repoUrl.hashCode())}")
+    }
+
+    /** Candidate manifest URLs for what the user typed. */
+    private fun candidateUrls(input: String): List<String> {
+        val trimmed = input.trim().trimEnd('/')
+        return if (trimmed.substringAfterLast('/').endsWith(".json", ignoreCase = true)) {
+            listOf(trimmed)
+        } else {
+            listOf("$trimmed/manifest.json", trimmed)
+        }
+    }
+
+    private class ParsedManifest(val name: String?, val scrapers: List<JSONObject>)
+
+    /** Returns null when the body is not a Nuvio manifest (for example a CloudStream repo.json). */
+    private fun parseManifest(body: String): ParsedManifest? {
+        val text = body.trim()
+        return try {
+            val (name, array) = when {
+                text.startsWith("[") -> null to JSONArray(text)
+                text.startsWith("{") -> {
+                    val obj = JSONObject(text)
+                    if (obj.has("pluginLists")) return null
+                    val arr = obj.optJSONArray("scrapers") ?: obj.optJSONArray("providers") ?: return null
+                    obj.optString("name").takeIf { it.isNotBlank() } to arr
+                }
+                else -> return null
+            }
+            val scrapers = (0 until array.length())
+                .mapNotNull { array.optJSONObject(it) }
+                .filter { it.optString("filename").isNotBlank() }
+            if (scrapers.isEmpty()) null else ParsedManifest(name, scrapers)
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    private suspend fun fetchManifest(input: String): Pair<String, ParsedManifest>? {
+        for (url in candidateUrls(input)) {
+            val body = try {
+                app.get(url).takeIf { it.isSuccessful }?.text
+            } catch (e: Exception) {
+                null
+            } ?: continue
+            parseManifest(body)?.let { return url to it }
+        }
+        return null
+    }
+
+    /**
+     * Tries to add [input] as a Nuvio repository.
+     * Returns null when the url is not a Nuvio manifest so the caller can fall back to CloudStream repos.
+     */
+    suspend fun tryAddRepository(input: String, customName: String?): Pair<NuvioRepo, Int>? =
+        withContext(Dispatchers.IO) {
+            if (!input.trim().startsWith("http", ignoreCase = true)) return@withContext null
+            val (url, manifest) = fetchManifest(input) ?: return@withContext null
+            val repo = NuvioRepo(
+                url = url,
+                name = customName?.takeIf { it.isNotBlank() } ?: manifest.name ?: "Nuvio deposu"
+            )
+            val count = lock.withLock {
+                setKey(REPOS_KEY, (getRepositories().filter { it.url != url } + repo).toTypedArray())
+                installScrapers(repo, manifest)
+            }
+            registerProviderIfNeeded()
+            repo to count
+        }
+
+    /** Downloads every provider script of [manifest]; returns how many were installed. Call under [lock]. */
+    private suspend fun installScrapers(repo: NuvioRepo, manifest: ParsedManifest): Int {
+        val folder = folderFor(repo.url) ?: return 0
+        folder.deleteRecursively()
+        folder.mkdirs()
+        val baseUrl = repo.url.substringBeforeLast('/')
+        val installed = mutableListOf<NuvioScraper>()
+
+        for (info in manifest.scrapers) {
+            try {
+                val disabled = info.optJSONArray("disabledPlatforms")
+                if (disabled != null && (0 until disabled.length()).any {
+                        disabled.optString(it).equals("android", true)
+                    }) continue
+
+                val filename = info.getString("filename")
+                val id = info.optString("id").ifBlank { filename.substringAfterLast('/').substringBeforeLast('.') }
+                val codeUrl = if (filename.startsWith("http")) filename else "$baseUrl/${filename.trimStart('/')}"
+                val response = app.get(codeUrl)
+                if (!response.isSuccessful) continue
+                val code = response.text
+                if (code.isBlank()) continue
+
+                val file = File(folder, id.replace(Regex("[^A-Za-z0-9._-]"), "_") + ".js")
+                file.writeText(code)
+
+                val types = info.optJSONArray("supportedTypes")?.let { arr ->
+                    (0 until arr.length()).map { arr.optString(it) }.filter { it.isNotBlank() }
+                } ?: emptyList()
+
+                installed += NuvioScraper(
+                    id = id,
+                    name = info.optString("name").ifBlank { id },
+                    repoUrl = repo.url,
+                    file = file.absolutePath,
+                    supportedTypes = types,
+                )
+            } catch (e: Exception) {
+                Log.e(TAG, "Provider could not be installed: ${e.message}")
+            }
+        }
+
+        setKey(SCRAPERS_KEY, (getScrapers().filter { it.repoUrl != repo.url } + installed).toTypedArray())
+        return installed.size
+    }
+
+    suspend fun removeRepository(url: String) = withContext(Dispatchers.IO) {
+        lock.withLock {
+            setKey(REPOS_KEY, getRepositories().filter { it.url != url }.toTypedArray())
+            setKey(SCRAPERS_KEY, getScrapers().filter { it.repoUrl != url }.toTypedArray())
+            folderFor(url)?.deleteRecursively()
+        }
+    }
+
+    @Volatile
+    private var refreshedThisSession = false
+
+    /** Refreshes providers once per app start. */
+    suspend fun refreshOncePerSession() {
+        if (refreshedThisSession) return
+        refreshedThisSession = true
+        refreshAll()
+    }
+
+    /** Re-downloads every repository so providers stay up to date. */
+    suspend fun refreshAll() = withContext(Dispatchers.IO) {
+        for (repo in getRepositories()) {
+            try {
+                val (_, manifest) = fetchManifest(repo.url) ?: continue
+                lock.withLock { installScrapers(repo, manifest) }
+            } catch (e: Exception) {
+                Log.e(TAG, "Refresh failed for ${repo.url}: ${e.message}")
+            }
+        }
+    }
+
+    /** Adds the Nuvio provider to the provider list once at least one Nuvio repository exists. */
+    fun registerProviderIfNeeded() {
+        if (!hasRepositories()) return
+        APIHolder.allProviders.withLock {
+            if (APIHolder.allProviders.any { it is NuvioProvider }) return@withLock
+            val provider = NuvioProvider()
+            APIHolder.allProviders.add(provider)
+            APIHolder.addPluginMapping(provider)
+        }
+    }
+
+    /** Runs all installed providers for one title and reports each stream as it arrives. */
+    suspend fun getStreams(
+        tmdbId: String,
+        mediaType: String,
+        season: Int?,
+        episode: Int?,
+        onResult: (NuvioScraper, LocalScraperResult) -> Unit
+    ): Int = coroutineScope {
+        val scrapers = getScrapers().filter { it.supports(mediaType) }
+        val semaphore = Semaphore(MAX_PARALLEL)
+        scrapers.map { scraper ->
+            async(Dispatchers.IO) {
+                semaphore.withPermit {
+                    try {
+                        val code = File(scraper.file).takeIf { it.exists() }?.readText()
+                            ?: return@withPermit 0
+                        val results = runtime.executePlugin(
+                            code, tmdbId, mediaType, season, episode, scraper.id
+                        )
+                        results.forEach { onResult(scraper, it) }
+                        results.size
+                    } catch (e: Throwable) {
+                        Log.e(TAG, "${scraper.name} failed: ${e.message}")
+                        0
+                    }
+                }
+            }
+        }.awaitAll().sum()
+    }
+}
