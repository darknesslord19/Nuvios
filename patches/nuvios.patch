diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index c714368..354e0e9 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -85,6 +85,15 @@ android {
     }
 
     signingConfigs {
+        // Nuvios: a fixed key for CI builds so every new APK installs over the old one
+        System.getenv("NUVIOS_KEYSTORE")?.takeIf { File(it).exists() }?.let { ks ->
+            getByName("debug") {
+                storeFile = File(ks)
+                storePassword = "android"
+                keyAlias = "androiddebugkey"
+                keyPassword = "android"
+            }
+        }
         // We just use SIGNING_KEY_ALIAS here since it won't change
         // so won't kill the configuration cache.
         if (System.getenv("SIGNING_KEY_ALIAS") != null) {
@@ -103,10 +112,11 @@ android {
     compileSdk = libs.versions.compileSdk.get().toInt()
 
     defaultConfig {
-        applicationId = "com.lagradost.cloudstream3"
+        applicationId = "com.darknesslord19.nuvios"
         minSdk = libs.versions.minSdk.get().toInt()
         targetSdk = libs.versions.targetSdk.get().toInt()
-        versionCode = libs.versions.versionCode.get().toInt()
+        // Every CI build gets a higher versionCode so it installs over the previous one
+        versionCode = libs.versions.versionCode.get().toInt() + (System.getenv("GITHUB_RUN_NUMBER")?.toIntOrNull() ?: 0)
         versionName = libs.versions.versionName.get()
 
         manifestPlaceholders["target_sdk_version"] = libs.versions.targetSdk.get()
@@ -119,6 +129,11 @@ android {
             "BUILD_DATE",
             "${System.currentTimeMillis()}"
         )
+        buildConfigField(
+            "String",
+            "TMDB_API_KEY",
+            "\"" + (System.getenv("TMDB_API_KEY") ?: localProperties["tmdb.key"] ?: "") + "\""
+        )
         buildConfigField(
             "String",
             "SIMKL_CLIENT_ID",
@@ -280,6 +295,10 @@ dependencies {
 
     // Temp/deprecated; will be removed once extensions have time to migrate from using it
     implementation("com.google.code.gson:gson:2.11.0")
+
+    // Nuvio JS providers: QuickJS engine (quickjs-kt, native lib renamed to avoid clashing with zipline) + crypto-js
+    implementation(files("libs/quickjs-kt-android-1.0.5-nuvio-qjz.aar"))
+    implementation("org.webjars.npm:crypto-js:4.2.0")
     // Deprecated; will be removed once extensions have time to migrate from using it
     implementation("me.xdrop:fuzzywuzzy:1.4.0")
 
