+package com.lagradost.cloudstream3.nuvio
+
+import com.fasterxml.jackson.annotation.JsonProperty
+import kotlin.math.roundToInt
+
+/** TMDB key exposed to Nuvio providers as globalThis.TMDB_API_KEY (same public key CloudStream's TmdbProvider uses). */
+const val NUVIO_TMDB_API_KEY = "e6333b32409e02a4a6eba6fb7ff866bb"
+
+/** One stream returned by a Nuvio provider's getStreams(). Field names match NuvioTV's model. */
+data class LocalScraperResult(
+    val title: String,
+    val name: String? = null,
+    val url: String,
+    val quality: String? = null,
+    val size: String? = null,
+    val language: String? = null,
+    val provider: String? = null,
+    val type: String? = null,
+    val seeders: Int? = null,
+    val peers: Int? = null,
+    val infoHash: String? = null,
+    val headers: Map<String, String>? = null,
+    val subtitles: List<Subtitle> = emptyList(),
+    val audioDelayMs: Int? = null
+)
+
+data class Subtitle(
+    val id: String,
+    val url: String,
+    val lang: String,
+    val addonName: String,
+    val addonLogo: String?,
+    val isStreamProvided: Boolean = false,
+    val headers: Map<String, String>? = null
+)
+
+fun Number?.toStreamAudioDelayMs(): Int? =
+    this?.toDouble()?.takeIf { it.isFinite() }?.roundToInt()?.coerceIn(-10_000, 10_000)
+
+/** A Nuvio provider repository (manifest.json). */
+data class NuvioRepo(
+    @JsonProperty("url") val url: String,
+    @JsonProperty("name") val name: String,
+)
+
+/** One installed Nuvio provider script. */
+data class NuvioScraper(
+    @JsonProperty("id") val id: String,
+    @JsonProperty("name") val name: String,
+    @JsonProperty("repoUrl") val repoUrl: String,
+    @JsonProperty("file") val file: String,
+    @JsonProperty("supportedTypes") val supportedTypes: List<String>,
+) {
+    fun supports(mediaType: String): Boolean {
+        if (supportedTypes.isEmpty()) return true
+        return supportedTypes.any { normalizeType(it) == normalizeType(mediaType) }
+    }
+
+    companion object {
+        fun normalizeType(value: String): String = when (value.lowercase()) {
+            "series", "show", "tvseries", "anime", "other" -> "tv"
+            else -> value.lowercase()
+        }
+    }
+}
