diff --git a/app/src/main/java/com/lagradost/cloudstream3/utils/TmdbPosters.kt b/app/src/main/java/com/lagradost/cloudstream3/utils/TmdbPosters.kt
new file mode 100644
index 0000000..36af8cd
--- /dev/null
+++ b/app/src/main/java/com/lagradost/cloudstream3/utils/TmdbPosters.kt
@@ -0,0 +1,91 @@
+package com.lagradost.cloudstream3.utils
+
+import androidx.preference.PreferenceManager
+import com.lagradost.cloudstream3.BuildConfig
+import com.lagradost.cloudstream3.CloudStreamApp
+import com.lagradost.cloudstream3.TvType
+import com.lagradost.cloudstream3.app
+import com.lagradost.cloudstream3.nuvio.NUVIO_TMDB_API_KEY
+import org.json.JSONObject
+import java.net.URLEncoder
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Finds a poster on TMDB for titles whose provider gave none.
+ * The API key is a setting (Ayarlar › Genel › TMDB API anahtarı).
+ */
+object TmdbPosters {
+    const val PREF_KEY = "tmdb_api_key"
+    private const val IMAGE_BASE = "https://image.tmdb.org/t/p/w342"
+
+    /** "" means: looked up, nothing found. */
+    private val cache = ConcurrentHashMap<String, String>()
+
+    fun defaultKey(): String = BuildConfig.TMDB_API_KEY.takeIf { it.isNotBlank() } ?: NUVIO_TMDB_API_KEY
+
+    fun apiKey(): String {
+        val ctx = CloudStreamApp.context
+        val saved = ctx?.let {
+            PreferenceManager.getDefaultSharedPreferences(it).getString(PREF_KEY, null)
+        }?.trim()
+        return saved?.takeIf { it.isNotEmpty() } ?: defaultKey()
+    }
+
+    fun clearCache() = cache.clear()
+
+    private val yearRegex = Regex("""\b(19|20)\d{2}\b""")
+    private val noiseRegex = Regex(
+        """\(\s*\d{4}\s*\)|\[[^]]*]|(?i)\b(türkçe|turkce|tr)?\s*(dublaj|dublajlı|altyazılı|altyazili|altyazı|izle|full\s*hd|hd|1080p|720p|4k|uhd)\b"""
+    )
+
+    fun cleanTitle(name: String): String =
+        noiseRegex.replace(name, " ").replace(Regex("""[|•·:–-]+\s*$"""), " ")
+            .replace(Regex("""\s+"""), " ").trim()
+
+    private fun enc(s: String) = URLEncoder.encode(s, "UTF-8")
+
+    suspend fun poster(name: String, type: TvType?): String? {
+        val query = cleanTitle(name)
+        if (query.length < 2) return null
+        val year = yearRegex.find(name)?.value
+        val endpoint = when (type) {
+            TvType.Movie, TvType.AnimeMovie -> "movie"
+            TvType.TvSeries, TvType.Anime, TvType.Cartoon, TvType.AsianDrama, TvType.OVA -> "tv"
+            else -> "multi"
+        }
+        val cacheKey = "$endpoint|${query.lowercase()}|$year"
+        cache[cacheKey]?.let { return it.ifEmpty { null } }
+
+        val yearParam = when {
+            year == null -> ""
+            endpoint == "movie" -> "&year=$year"
+            endpoint == "tv" -> "&first_air_date_year=$year"
+            else -> ""
+        }
+        val url = "https://api.themoviedb.org/3/search/$endpoint?api_key=${enc(apiKey())}" +
+            "&query=${enc(query)}&language=tr-TR&include_adult=false$yearParam"
+
+        val found = try {
+            val response = app.get(url)
+            if (!response.isSuccessful) null else {
+                val results = JSONObject(response.text).optJSONArray("results")
+                var path: String? = null
+                if (results != null) {
+                    for (i in 0 until results.length()) {
+                        val r = results.optJSONObject(i) ?: continue
+                        if (r.optString("media_type") == "person") continue
+                        val p = r.optString("poster_path")
+                        if (p.isNotBlank() && p != "null") {
+                            path = p; break
+                        }
+                    }
+                }
+                path?.let { IMAGE_BASE + it }
+            }
+        } catch (e: Exception) {
+            null
+        }
+        cache[cacheKey] = found ?: ""
+        return found
+    }
+}
